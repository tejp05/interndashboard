# ── Required ────────────────────────────────────────────────────────────────
# Neon Postgres connection string.
# Vercel Dashboard → Storage → Create Database → Neon → this is injected
# automatically as DATABASE_URL when you link the store to the project.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session cookies (HS256 JWT).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign up.
# Leave unset to allow any email address.
ALLOWED_EMAIL_DOMAINS=ibm.com,us.ibm.com

# Shared invite code required at signup. Leave unset to disable.
SIGNUP_INVITE_CODE=

# Cohort label shown in the directory header.
COHORT_NAME=Summer 2026 Interns
